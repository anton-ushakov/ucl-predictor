# ============================================================
# Скопируйте этот файл в .env и впишите свои значения:
#     cp .env.example .env && nano .env
# Файл .env в git не попадает и остаётся только на сервере.
# ============================================================

# Пароль базы данных. Придумайте длинный, вводить его руками не придётся.
DB_PASSWORD=смените_меня_на_длинный_пароль

# Токен football-data.org
FOOTBALL_DATA_TOKEN=ваш_токен

# Ключ api-sports.io (API-Football). Нужен для турниров, которых нет в бесплатном тарифе
# football-data.org: Лига Европы, чемпионат России, Лига наций. Без ключа эти турниры
# остаются ручными, всё остальное работает как прежде.
# Бесплатный тариф — 100 запросов в сутки; сервер держится в пределах 90.
API_FOOTBALL_KEY=

# --- Только для арендованного сервера (docker-compose.yml) ---
# Адрес сервера, по которому приложение будет доступно.
# Свой домен:            shaurma.example.com
# Без домена (бесплатно): 203.0.113.10.sslip.io  — подставьте IP своего сервера
SERVER_NAME=ваш_адрес

# --- Только для домашнего варианта с туннелем (docker-compose.home.yml) ---
# Ключ туннеля Cloudflare. Нужен, только когда открываем доступ из интернета.
# Как его получить, описано в ДОМА.md.
TUNNEL_TOKEN=

# --- Мгновенные оповещения (Firebase), необязательно ---
# Положите файл ключа служебной учётной записи рядом с этим файлом
# и укажите путь к нему ниже. Без ключа оповещения всё равно работают,
# просто приходят опросом раз в 15 минут.
FIREBASE_KEY=./firebase-service-account.json
FIREBASE_PROJECT_ID=shaurmaleague

# --- Общие ---
# Кто может рассылать объявления всем участникам, например о новой версии
# приложения, и разбирать заявки на регистрацию. Через запятую.
#
# Можно писать имя — ровно как при входе в приложение, — но надёжнее номер
# участника: «id:3». Имя меняется прямо в приложении, и тогда владелец
# перестаёт совпадать с этой строкой, а права пропадают молча. Номер не
# меняется никогда. Где его взять: экран «Участники приложения» показывает
# его рядом с именем, или ./sql.sh "SELECT id, username FROM app_users".
#
# Примеры:  ADMIN_USERNAMES=id:3      ADMIN_USERNAMES=id:3,анна
ADMIN_USERNAMES=ваше_имя


# На сколько недель вперёд можно делать прогнозы
WEEKS_AHEAD=4

# Часовой пояс, по которому считаются недели туров и время закрытия приёма.
# Менять только по согласию с друзьями: от него зависят границы туров.
APP_TIMEZONE=Europe/Moscow
