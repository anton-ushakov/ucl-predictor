# ============================================================
# Скопируйте этот файл в .env и впишите свои значения:
#     cp .env.example .env && nano .env
# Файл .env в git не попадает и остаётся только на сервере.
# ============================================================

# Пароль базы данных. Придумайте длинный, вводить его руками не придётся.
DB_PASSWORD=смените_меня_на_длинный_пароль

# Токен football-data.org
FOOTBALL_DATA_TOKEN=ваш_токен

# --- Только для арендованного сервера (docker-compose.yml) ---
# Адрес сервера, по которому приложение будет доступно.
# Свой домен:            shaurma.example.com
# Без домена (бесплатно): 203.0.113.10.sslip.io  — подставьте IP своего сервера
SERVER_NAME=ваш_адрес

# --- Только для домашнего варианта с туннелем (docker-compose.home.yml) ---
# Ключ туннеля Cloudflare. Нужен, только когда открываем доступ из интернета.
# Как его получить, описано в ДОМА.md.
TUNNEL_TOKEN=

# --- Общие ---
# На сколько недель вперёд можно делать прогнозы
WEEKS_AHEAD=4

# Часовой пояс, по которому считаются недели туров и время закрытия приёма.
# Менять только по согласию с друзьями: от него зависят границы туров.
APP_TIMEZONE=Europe/Moscow
